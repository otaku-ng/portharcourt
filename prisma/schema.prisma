generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  UPCOMING
  ARCHIVED
}

model Event {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  eyebrow       String
  description   String
  startAt       DateTime?
  endAt         DateTime?
  dateLabel     String?
  timeLabel     String?
  location      String
  venue         String?
  coverImageUrl String
  coverImageKey String?
  coverImageAlt String
  status        EventStatus
  published     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([published, status, startAt])
}
