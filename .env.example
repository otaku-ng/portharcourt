# Local PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ph_otakus?schema=public"

# Optional deployment override for the default PH Otakus group invite.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/C9ejyNTEYdpJ7xv7AETRXz?s=cl&p=i&ilr=4&amv=1

# Cloudflare R2 S3-compatible storage for event covers, gallery images and story covers.
# Keep all R2 credentials server-side; do not prefix them with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public read URL or custom domain, without a trailing slash.
R2_PUBLIC_BASE_URL=https://media.example.com

# Temporary admin gate for Phase 2B.
ADMIN_PASSWORD=
# Use a long random value (at least 32 characters) in deployed environments.
ADMIN_SESSION_SECRET=
